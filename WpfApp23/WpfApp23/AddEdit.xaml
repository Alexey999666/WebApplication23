<Window x:Class="WpfApp23.AddEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp23"
        mc:Ignorable="d"
        Title="Добавить/Редактировать" x:Name="addEditWindow" Height="400" Width="300" ResizeMode="CanMinimize" Loaded="Window_Loaded" WindowStartupLocation="CenterOwner">
    <Grid>
        <StackPanel Margin="10">
            <Label Content="Код растения" Margin="0,2,0,5"/>
            <TextBox Height="20" Margin="0,0,0,10" x:Name="tbCod" Text="{Binding Path=Код}"/>

            <Label Content="Название растения" Margin="0,2,0,5"/>
            <TextBox Height="20" Margin="0,0,0,10" x:Name="tbName" Text="{Binding Path=Название}"/>

            <Label Content="Семейство" Margin="0,2,0,5"/>
            <TextBox Height="20" Margin="0,0,0,10" x:Name="tbSem" Text="{Binding Path=Семейство}"/>

            <Label Content="Раздел" Margin="0,2,0,5"/>
            <TextBox Height="20" Margin="0,0,0,10" x:Name="tbRaz" Text="{Binding Path=Раздел}"/>

            <Button x:Name="btnAdd" Click="btnAddEdit_Click" Content="Добавить" Margin="0,20,0,0"/>
            <Button x:Name="btnCancel" Click="btnClose_Click" Content="Отмена" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
