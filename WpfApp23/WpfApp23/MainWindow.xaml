<Window x:Class="WpfApp23.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp23"
        mc:Ignorable="d"
        Title="Растения" x:Name="mainWindow" Height="450" Width="800" Loaded="Window_Loaded" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Initialized="Window_Initialized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="206*"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0">
            <MenuItem Header="Файл" Height="21">
                <MenuItem Header="Информация" Click="btnInfo_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="btnClose_Click"/>
            </MenuItem>
            <MenuItem Header="Добавить" x:Name="btnAdd" Click="btnAdd_Click" Height="21"/>
            <MenuItem Header="Редактировать" x:Name="btnEdit" Click="btnEdit_Click" Height="21"/>
            <MenuItem Header="Удалить" x:Name="btnDelete" Click="btnDel_Click" Height="21"/>
        </Menu>

        <ListView x:Name="listView" ScrollViewer.HorizontalScrollBarVisibility="Visible"  Grid.Row="1" Margin="0,2,0,0" Grid.RowSpan="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="550*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="50*"/>
                        </Grid.RowDefinitions>


                        <TextBlock Text="{Binding Код, StringFormat={}Код растения: {0}}" Grid.Row="0" Grid.Column="0" TextAlignment="Right" FontSize="18"/>

                        <TextBlock Text="{Binding Название, StringFormat={}Название растения: {0}}" Grid.Row="1" Grid.Column="0" TextAlignment="Right" FontSize="18"/>

                        <TextBlock Text="{Binding Семейство, StringFormat={}Семейство: {0}}" Grid.Row="2" Grid.Column="0" TextAlignment="Right" FontSize="18"/>

                        <TextBlock Text="{Binding Раздел, StringFormat={}Раздел: {0}}" Grid.Row="1" Grid.Column="1" TextAlignment="Right" FontSize="18"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Window>
