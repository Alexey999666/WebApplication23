<Window x:Class="WpfApp23.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp23"
        mc:Ignorable="d"
        Title="Авторизация" Height="400" Width="300" Activated="Window_Activated" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Margin="20">
            <Label Content="Пользователь" Margin="0,2,0,10" FontSize="14"/>
            <TextBox x:Name="tbLogin" Height="25" Margin="0,0,0,20" FontSize="14"/>

            <Label Content="Пароль" Margin="0,0,0,10" FontSize="14"/>
            <PasswordBox x:Name="tbPass" Height="30" Margin="0,0,0,30" FontSize="14"/>

            <Button Content="Войти" Click="btnEnter_Click" IsDefault="True" Margin="0,0,0,15" Height="25"/>
            <Button Content="Отмена" Click="btnCancel_Click" IsCancel="True" Margin="0,0,0,15" Height="25"/>
            <Button Content="Войти как гость" Click="btnGuest_Click" Margin="0,0,0,15" Height="25"/>
        </StackPanel>
    </Grid>
</Window>